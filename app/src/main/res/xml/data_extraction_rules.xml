<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- FCM registration tokens are installation-specific and must not be restored. -->
        <exclude domain="file" path="datastore/notification_state.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/notification_state.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
